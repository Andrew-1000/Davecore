# Supabase project (website sign-in, plans, testimonials, contact details, enquiries).
# Project Settings → API Keys: Project URL and the *publishable* (anon) key. Never the secret/service_role key.
# Leave empty to run with the built-in content in app/data.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Davecore BQ system (embedded cost calculators). No trailing slash.
NUXT_PUBLIC_BQ_API_BASE=http://localhost:3000

# Path the site is served from. "/" locally or with a custom domain; "/<repo-name>/" on GitHub Pages project sites.
# NUXT_APP_BASE_URL=/   (set only when building for a sub-path, e.g. /davecore-website/)
