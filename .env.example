# Base URL of the Davecore BQ system (API, sign-in, calculators). No trailing slash.
NUXT_PUBLIC_BQ_API_BASE=http://localhost:3000

# Path the site is served from. "/" locally or with a custom domain; "/<repo-name>/" on GitHub Pages project sites.
# NUXT_APP_BASE_URL=/   (set only when building for a sub-path, e.g. /davecore-website/)
